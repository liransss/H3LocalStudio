{
  "name": "h3-local-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,studio -c magenta,cyan \"npm:backend:dev\" \"npm:frontend:dev\"",
    "frontend:dev": "vite --host 127.0.0.1",
    "backend:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-backend.ps1 -Mock",
    "backend:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m pytest",
    "check": "npm.cmd run build && npm.cmd run test:backend",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.8.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "rollup": "npm:@rollup/wasm-node@^4.62.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
